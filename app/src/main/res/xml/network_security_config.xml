<?xml version="1.0" encoding="utf-8"?>
<!-- Trusts user-installed CAs too, so the app keeps working behind VPNs or
     networks that inspect TLS with their own certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
